# Copy to .env. Demo never calls paid APIs or publishes externally.
DEMO_MODE=true
PORT=3000
HOST=127.0.0.1
PUBLIC_ORIGIN=http://localhost:3000
DATA_DIR=./data
# Manual scripts and uploaded narration are the default. No AI account is needed.
# Explicitly enable only to use legacy generation (which can incur provider costs).
ENABLE_AI_FEATURES=false
MAX_AUDIO_UPLOAD_MB=30
MAX_VIDEO_DURATION_SECONDS=60
# Demo login defaults to creator / local-demo-only. Change in production.
OWNER_USERNAME=creator
OWNER_PASSWORD=
# Production requires separate random values of at least 32 characters.
SESSION_SECRET=
TOKEN_ENCRYPTION_KEY=
NODE_ENV=development
# Optional legacy AI credentials; never used by manual uploads/rendering/alignment.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_multilingual_v2
ELEVENLABS_VOICE_ID=
# Compatible pinned Meta version; confirm support in your Meta app dashboard.
META_API_VERSION=v25.0
META_APP_ID=
META_APP_SECRET=
FACEBOOK_PAGE_ID=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Private media folder on the machine running the app. No Cloudflare account needed.
STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=./data/media
# Docker host folder only: mounted at /app/media for BOTH web and worker.
MEDIA_HOST_PATH=./data/media
# Only live Instagram URL delivery needs a publicly reachable HTTPS origin.
# Leaving this blank uses PUBLIC_ORIGIN. No tunnel is created automatically.
PUBLIC_MEDIA_ORIGIN=
MEDIA_LINK_TTL_HOURS=48
# Optional remote adapter, used only when STORAGE_PROVIDER=r2 or reading old R2 assets.
# Keep the R2 bucket private. The legacy STORAGE setting remains a fallback.
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Optional browser and binary overrides (Docker uses /usr/bin/chromium).
BROWSER_EXECUTABLE=
FFMPEG_PATH=
FFPROBE_PATH=
RENDER_CONCURRENCY=1
# Conservative estimates per generation, editable deployment inputs; not billing caps.
TEXT_ESTIMATE_USD=0.03
VOICE_PER_1000_CHARS_USD=0.30
